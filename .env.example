# Agri-Env Ops Dashboard configuration. Copy to `.env` and fill in; NEVER commit .env.
# Precedence: CLI flags > process environment > .env.

# --- Broker ---
MQTT_HOST=127.0.0.1
MQTT_PORT=1883
MQTT_USER=
MQTT_PASSWORD=
# Optional topic prefix prepended to every subscription (e.g. a farm namespace).
MQTT_PREFIX=

# --- Input mode: auto | uplink | bridge ---
# uplink: decode raw ChirpStack uplinks (default topic application/+/device/+/event/up)
# bridge: consume the normalized agri-env-bridge contract (default topic agri_env/+/+/state)
# auto:   pick from MQTT_TOPIC (a <base>/+/+/state topic means bridge, else uplink)
MQTT_SOURCE=auto
# MQTT_TOPIC=application/+/device/+/event/up
# MQTT_TOPIC=agri_env/+/+/state

# --- TLS (production brokers) ---
# MQTT_TLS=1
# MQTT_CAFILE=/path/to/ca.crt

# --- Listeners (optional) ---
# FARM_BIND=0.0.0.0
# FARM_HTTP_PORT=8000
# FARM_WS_PORT=8765
# FARM_DB=./farm.db
